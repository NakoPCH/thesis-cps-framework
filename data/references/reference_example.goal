// Example 1:
Broker<MQTT> HomeMQTT
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Entity TempSensor1
    type: sensor
    uri: 'bedroom.sensor.temperature'
    source: HomeMQTT    // Note that the source: key should match the name of the Broker defined, which is HomeMQTT in this case
    attributes:
        - temp: float
end

Entity TempSensor2
    type: sensor
    uri: 'bathroom.sensor.temperature'
    source: HomeMQTT
    attributes:
        - temp: float
end

Entity TempSensor3
    type: sensor
    uri: 'livingroom.sensor.temperature'
    source: HomeMQTT
    attributes:
        - temp: float
end

Entity AirQualitySensor1
    type: sensor
    uri: 'kitchen.sensor.airq'
    source: HomeMQTT
    attributes:
        - gas: float
        - humidity: float
end

Goal<EntityStateChange> Goal_1
    entity: TempSensor1
end

Goal<EntityStateCondition> Goal_2   // Note that this type of goal has only condition: key and optional timeConstraints: key, it does not have entity: key
    condition:
        (AirQualitySensor1.gas < 10) and    // Note that conditions are written inside PARENTHESIS and can be combined with logical operators like AND, OR, NOT
        (AirQualitySensor1.humidity < 30)
end

Goal<EntityStateCondition> Goal_3
    condition: (TempSensor1.temp > 10) and
    (TempSensor2.temp > 10) and
    (TempSensor3.temp > 10)
end

Goal<Complex> CG1
    goals:
        - Goal_1 -> 0.9
        - Goal_2 -> 0.8
        - Goal_3 -> 1.0
    strategy: ALL_ACCOMPLISHED_ORDERED
end

Scenario MyScenario
    goals:
        - CG1
    concurrent: False
end

// Example 2:
Broker<MQTT> LocsysMQTT
    host: 'locsys.issel.ee.auth.gr'
    port: 8883
    ssl: true
    auth:
        username: 'sensors'
        password: 'issel.sensors'
end

Broker<MQTT> HomeMQTT
    host: 'localhost'
    port: 1883
    auth:
        username: ''
        password: ''
end

Broker<Redis> LocalRedis
    host: 'localhost'
    port: 6379
    auth:
        username: ''
        password: ''
end

Entity Robot1Pose
    type: sensor
    uri: 'gn_robot_1.pose.internal'
    source: LocalRedis
    attributes:
        - position: dict
        - orientation: dict
end

Goal<Position> MoveToPointA
    entity: Robot1Pose
    position: Point2D(5.0, 5.0) // Note that correct key is position:, not target:
    maxDeviation: 0.5
end

Goal<CircularArea> Goal_1
    center: Point3D(100, 5, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<CircularArea> Goal_2
    center: Point3D(100, 10, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<CircularArea> Goal_3
    center: Point3D(95, 10, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<CircularArea> Goal_4
    center: Point3D(95, 5, 0)
    radius: 0.5
    tag: ENTER
    timeConstraints:
        - FROM_GOAL_START(<60)
end

Goal<CircularArea> Goal_5
    center: Point3D(125, 5, 0)
    radius: 5
    tag: AVOID
end

Goal<RectangleArea> Goal_6
    entities:
        - Robot1Pose
    bottomLeftEdge: Point3D(0, 0, 0)
    lengthX: 5
    lengthY: 5
    tag: ENTER
    timeConstraints:
        - FOR_TIME(5)
        - FROM_GOAL_START(<180)
end

RTMonitor
    broker: LocalRedis
    eventTopic: "goaldsl.{U_ID}.event"
    logsTopic: "goaldsl.{U_ID}.log"
end

Scenario DoRectangleScenario
    goals:
        - Goal_1
        - Goal_2
        - Goal_3
        - Goal_4
    concurrent: False
end

// Extra helpful notes after observing common mistakes in the generated code:
//
// * TimeConstraint Structure:
//  - Syntax: `<Type>(<optional_comparator><float_time>)`
//  - Allowed Types (`type`): `FROM_SCENARIO_START` | `FROM_GOAL_START` | `FOR_TIME` | `BETWEEN_GOALS_MIN` | `BETWEEN_GOALS_MAX`
//  - Allowed Comparators (`comparator`): `>` | `<` | `==` | `>=` | `<=`
//  - Examples:
//    - `- FROM_GOAL_START(<60)`
//    - `- FOR_TIME(5)`
//    - `- FROM_SCENARIO_START(<=180.0)`